      "pressed": "rgb(--color-brand-pressed / <alpha-value>)",
      "text": "rgb(--color-brand-text / <alpha-value>)"
    },
    "language": {
      "DEFAULT": "rgb(--color-language / <alpha-value>)",
      "hover": "rgb(--color-language-hover / <alpha-value>)",
      "soft": "rgb(--color-language-soft / <alpha-value>)",
      "text": "rgb(--color-language-text / <alpha-value>)"
    },
    "success": {
      "DEFAULT": "rgb(--color-success / <alpha-value>)",
      "soft": "rgb(--color-success-soft / <alpha-value>)"
    },
    "warning": {
      "DEFAULT": "rgb(--color-warning / <alpha-value>)",
      "soft": "rgb(--color-warning-soft / <alpha-value>)"
    },
    "danger": {
      "DEFAULT": "rgb(--color-danger / <alpha-value>)",
      "soft": "rgb(--color-danger-soft / <alpha-value>)"
    },
    "info": {
      "DEFAULT": "rgb(--color-info / <alpha-value>)",
      "soft": "rgb(--color-info-soft / <alpha-value>)"
    },
    "focus": "rgb(--color-focus / <alpha-value>)",
    "accent": {
      "sage": "rgb(--color-success / <alpha-value>)",
      "sky": "rgb(--color-info / <alpha-value>)"
    },
    "card": {
      "warm": "rgb(--color-brand-soft / <alpha-value>)",
      "sage": "rgb(--color-success-soft / <alpha-value>)",
      "sky": "rgb(--color-info-soft / <alpha-value>)",
      "heather": "rgb(--color-warning-soft / <alpha-value>)"
