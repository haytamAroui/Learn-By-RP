{
  "colors": {
    "canvas": "rgb(--color-canvas / <alpha-value>)",
    "surface": {
      "DEFAULT": "rgb(--color-surface / <alpha-value>)",
      "soft": "rgb(--color-surface-soft / <alpha-value>)",
      "hover": "rgb(--color-surface-hover / <alpha-value>)",
      "sunken": "rgb(--color-sunken / <alpha-value>)",
      "raised": "rgb(--color-raised / <alpha-value>)"
    },
    "border": {
      "DEFAULT": "rgb(--color-border-subtle / <alpha-value>)",
      "subtle": "rgb(--color-border-subtle / <alpha-value>)",
      "interactive": "rgb(--color-border-interactive / <alpha-value>)"
    },
    "ink": "rgb(--color-ink / <alpha-value>)",
    "body": "rgb(--color-body / <alpha-value>)",
    "muted": "rgb(--color-muted / <alpha-value>)",
    "brand": {
      "DEFAULT": "rgb(--color-brand / <alpha-value>)",
