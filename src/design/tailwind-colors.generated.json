{
  "colors": {
    "canvas": "rgb(var(--color-canvas) / <alpha-value>)",
    "surface": {
      "DEFAULT": "rgb(var(--color-surface) / <alpha-value>)",
      "soft": "rgb(var(--color-surface-soft) / <alpha-value>)",
      "hover": "rgb(var(--color-surface-hover) / <alpha-value>)",
      "sunken": "rgb(var(--color-sunken) / <alpha-value>)",
      "raised": "rgb(var(--color-raised) / <alpha-value>)"
    },
    "border": {
      "DEFAULT": "rgb(var(--color-border-subtle) / <alpha-value>)",
      "subtle": "rgb(var(--color-border-subtle) / <alpha-value>)",
      "interactive": "rgb(var(--color-border-interactive) / <alpha-value>)"
    },
    "ink": "rgb(var(--color-ink) / <alpha-value>)",
    "body": "rgb(var(--color-body) / <alpha-value>)",
    "muted": "rgb(var(--color-muted) / <alpha-value>)",
    "brand": {
      "DEFAULT": "rgb(var(--color-brand) / <alpha-value>)",
      "hover": "rgb(var(--color-brand-hover) / <alpha-value>)",
      "pressed": "rgb(var(--color-brand-pressed) / <alpha-value>)",
      "soft": "rgb(var(--color-brand-soft) / <alpha-value>)",
      "on": "rgb(var(--color-brand-text) / <alpha-value>)",
      "button": "rgb(var(--color-brand-button) / <alpha-value>)",
      "buttonHover": "rgb(var(--color-brand-button-hover) / <alpha-value>)",
      "buttonPressed": "rgb(var(--color-brand-button-pressed) / <alpha-value>)"
    },
    "primary": {
      "DEFAULT": "rgb(var(--color-brand) / <alpha-value>)",
      "dark": "rgb(var(--color-brand-hover) / <alpha-value>)",
      "pressed": "rgb(var(--color-brand-pressed) / <alpha-value>)",
      "text": "rgb(var(--color-brand-text) / <alpha-value>)"
    },
    "language": {
      "DEFAULT": "rgb(var(--color-language) / <alpha-value>)",
      "hover": "rgb(var(--color-language-hover) / <alpha-value>)",
      "soft": "rgb(var(--color-language-soft) / <alpha-value>)",
      "text": "rgb(var(--color-language-text) / <alpha-value>)"
    },
    "success": {
      "DEFAULT": "rgb(var(--color-success) / <alpha-value>)",
      "soft": "rgb(var(--color-success-soft) / <alpha-value>)"
    },
    "warning": {
      "DEFAULT": "rgb(var(--color-warning) / <alpha-value>)",
      "soft": "rgb(var(--color-warning-soft) / <alpha-value>)"
    },
    "danger": {
      "DEFAULT": "rgb(var(--color-danger) / <alpha-value>)",
      "soft": "rgb(var(--color-danger-soft) / <alpha-value>)"
    },
    "info": {
      "DEFAULT": "rgb(var(--color-info) / <alpha-value>)",
      "soft": "rgb(var(--color-info-soft) / <alpha-value>)"
    },
    "focus": "rgb(var(--color-focus) / <alpha-value>)",
    "accent": {
      "sage": "rgb(var(--color-success) / <alpha-value>)",
      "sky": "rgb(var(--color-info) / <alpha-value>)"
    },
    "card": {
      "warm": "rgb(var(--color-brand-soft) / <alpha-value>)",
      "sage": "rgb(var(--color-success-soft) / <alpha-value>)",
      "sky": "rgb(var(--color-info-soft) / <alpha-value>)",
      "heather": "rgb(var(--color-warning-soft) / <alpha-value>)"
    },
    "action": {
      "DEFAULT": "rgb(var(--color-brand-button) / <alpha-value>)",
      "hover": "rgb(var(--color-brand-button-hover) / <alpha-value>)",
      "pressed": "rgb(var(--color-brand-button-pressed) / <alpha-value>)",
      "text": "rgb(var(--color-brand-text) / <alpha-value>)"
    }
