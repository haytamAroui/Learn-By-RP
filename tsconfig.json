{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "index.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "nativewind-env.d.ts",
    "server/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".expo",
    "android",
    "ios"
  ],
  "extends": "expo/tsconfig.base"
}
