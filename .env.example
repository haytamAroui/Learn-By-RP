# ---------------------------------------------------------------------------
# LearnByRP provider runtime
# Secrets live on the API server only. Never expose GEMINI_API_KEY,
# OPENAI_API_KEY, or OPENAI_COMPATIBLE_API_KEY through EXPO_PUBLIC_* variables.
# ---------------------------------------------------------------------------

PORT=3000

# Number of trusted reverse-proxy hops in front of the API (leave unset for direct access).
TRUST_PROXY_HOPS=""

# SQLite file holding the shared provider quota counters.
#
# Set this whenever more than one API instance serves the deployment, and give every
# instance the same path. Unset, each instance keeps its own counters and the effective
# request limit multiplies by the instance count: a client can send `limit x instances`
# requests per minute and every instance reports it as within quota. A production server
# logs a warning when this is unset.
#
# The path must be on storage shared by all instances, the same requirement as the scene
# and privacy stores in .data/. Instances on separate hosts do not share a SQLite file
# and need a different backend behind the same quota-store interface.
LEARNBYRP_QUOTA_DB=".data/provider-quota.sqlite"

# Production guest ownership signing key. Keep stable across API restarts and
# replicas, generate with a cryptographic random source, and never expose publicly.
# Local development stores a private key in ignored .data/guest-identity.secret.
GUEST_IDENTITY_SECRET=""

# Mobile/web client -> LearnByRP API server.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"

# auto | openai-realtime | http
# auto discovers server capabilities, prefers Realtime, then falls back to HTTP.
EXPO_PUBLIC_CONVERSATION_PROVIDER="auto"

# ---------------------------------------------------------------------------
# Structured reasoning: actor fallback, coach, assessment
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.8-flash"

# gemini | openai-compatible | deterministic
# If omitted: Gemini when configured, then OpenAI-compatible, then deterministic.
STRUCTURED_PROVIDER=""

# Local/self-hosted OpenAI-compatible endpoint exposing /v1/chat/completions.
OPENAI_COMPATIBLE_BASE_URL="http://127.0.0.1:1234/v1"
OPENAI_COMPATIBLE_MODEL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_JSON_MODE="true"

# ---------------------------------------------------------------------------
# Character speech
# ---------------------------------------------------------------------------
# gemini | native
SPEECH_PROVIDER=""
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
# Optional per-locale Gemini voice overrides. A global voice override is
# intentionally unsupported so one language's voice cannot be forced on all.
# Character profiles with an authored voiceGender use the gender-specific key;
# otherwise the per-locale key below is used.
# GEMINI_TTS_VOICE_ES_ES="Kore"
# GEMINI_TTS_VOICE_FR_FR="Aoede"
# GEMINI_TTS_VOICE_NL_BE_FEMALE="<voice-library ID verified as female>"
# GEMINI_TTS_VOICE_NL_BE_MALE="<voice-library ID verified as male>"

# Native fallback is automatic and follows the selected target-language locale.

# ---------------------------------------------------------------------------
# OpenAI Realtime conversation brain
# ---------------------------------------------------------------------------
# Server-side only. The server mints short-lived client secrets.
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
