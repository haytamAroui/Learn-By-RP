# GEMINI_API_KEY: required by the API server (server/index.ts). Never ship this
# inside the app bundle. Set it in the shell that runs the server.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: local port for the API server.
PORT=3000

# EXPO_PUBLIC_API_BASE_URL: the deployed API base the mobile app calls.
# This one IS bundled into the app, so it must only ever contain a public URL.
#
#   Local simulator (iOS):  http://localhost:3000
#   Local simulator (Android emulator): http://10.0.2.2:3000
#   Physical device on your LAN:      http://192.168.x.x:3000
#   Production:                        https://your-api.example.com
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"
