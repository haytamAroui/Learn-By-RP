# ---------------------------------------------------------------------------
# LearnByRP provider runtime
# Secrets live on the API server only. Never expose GEMINI_API_KEY,
# OPENAI_API_KEY, or OPENAI_COMPATIBLE_API_KEY through EXPO_PUBLIC_* variables.
# ---------------------------------------------------------------------------

PORT=3000

# Mobile/web client -> LearnByRP API server.
EXPO_PUBLIC_API_BASE_URL="http://localhost:3000"

# auto | openai-realtime | http
# auto discovers server capabilities, prefers Realtime, then falls back to HTTP.
EXPO_PUBLIC_CONVERSATION_PROVIDER="auto"

# ---------------------------------------------------------------------------
# Structured reasoning: actor fallback, coach, assessment
# ---------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_TEXT_MODEL="gemini-3.8-flash"

# gemini | openai-compatible | deterministic
# If omitted: Gemini when configured, then OpenAI-compatible, then deterministic.
STRUCTURED_PROVIDER=""

# Local/self-hosted OpenAI-compatible endpoint exposing /v1/chat/completions.
OPENAI_COMPATIBLE_BASE_URL="http://127.0.0.1:1234/v1"
OPENAI_COMPATIBLE_MODEL=""
OPENAI_COMPATIBLE_API_KEY=""
OPENAI_COMPATIBLE_JSON_MODE="true"

# ---------------------------------------------------------------------------
# Character speech
# ---------------------------------------------------------------------------
# gemini | native
SPEECH_PROVIDER=""
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
GEMINI_TTS_VOICE="Puck"

# Native fallback is automatic and follows the selected target-language locale.

# ---------------------------------------------------------------------------
# OpenAI Realtime conversation brain
# ---------------------------------------------------------------------------
# Server-side only. The server mints short-lived client secrets.
OPENAI_API_KEY=""
OPENAI_REALTIME_MODEL="gpt-realtime-2.1"
