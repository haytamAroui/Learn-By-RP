{
  "name": "mission-coach",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:scenes": "tsx scripts/validate-scenes.mts",
    "generate": "tsx scripts/generate-css.mts && tsx scripts/generate-spec.mts",
    "server:dev": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "build:web": "expo export --platform web --output-dir web-build",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.26",
    "expo-audio": "57.0.5",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-modules-core": "~57.0.20",
    "expo-router": "^57.0.24",
    "expo-secure-store": "^57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-speech": "~57.0.3",
    "expo-speech-recognition": "~57.1.0",
    "expo-sqlite": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "fake-indexeddb": "^6.2.5",
    "lucide-react-native": "^1.49.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@google/genai": "^2.4.0",
    "@playwright/test": "^1.63.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.7"
  }
}
